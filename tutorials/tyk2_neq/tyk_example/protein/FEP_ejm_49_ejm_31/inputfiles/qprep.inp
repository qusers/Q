rl /zfsdata/data/david/Q/src/QligFEP/FF/AMBER14sb.lib 
rl ejm_49.lib
rl ejm_31_renumber.lib
rprm AMBER14sb_ejm_49_ejm_31_merged.prm 
! TO DO Change if protein system is used
rp ejm_49_ejm_31.pdb 
! solvation - density adapted to membrane proteins
set solvent_pack 2.3
set solute_density 0.05794
boundary 1 -4.703 26.536 -30.363 25
solvate -4.703 26.536 -30.363 25 4 water.pdb
!addbond at1 at2 y
maketop MKC_p 
writetop dualtop.top 
wp top_p.pdb y 
rt dualtop.top
mask none
mask not excluded 
wp complexnotexcluded.pdb y 
q 