rl /zfsdata/data/david/Q/src/QligFEP/FF/AMBER14sb.lib 
rl jmc_23.lib
rl jmc_28_renumber.lib
rprm AMBER14sb_jmc_23_jmc_28_merged.prm 
! TO DO Change if protein system is used
rp jmc_23_jmc_28.pdb 
! solvation - density adapted to membrane proteins
set solvent_pack 2.3
set solute_density 0.05794
boundary 1 -4.723 25.981 -30.566 25
solvate -4.723 25.981 -30.566 25 1 HOH
!addbond at1 at2 y
maketop MKC_p 
writetop dualtop.top 
wp top_p.pdb y 
rt dualtop.top
mask none
mask not excluded 
wp complexnotexcluded.pdb y 
q 