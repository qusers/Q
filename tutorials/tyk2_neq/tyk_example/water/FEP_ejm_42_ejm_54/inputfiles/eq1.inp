[MD]
steps                     10000
stepsize                  0.1
temperature               1
bath_coupling             0.2
random_seed               SEED_VAR
initial_temperature       1
shake_solvent             on
shake_hydrogens           off
shake_solute              off
lrf                       on
separate_scaling          on

[cut-offs]
solute_solvent            10
solute_solute             10
solvent_solvent           10
q_atom                    99
lrf                       99

[sphere]
shell_force               10.0
shell_radius              25

[solvent]
radial_force              60.0
polarisation              on
polarisation_force        20.0

[intervals]
output                    5
trajectory                100
non_bond                  25

[files]
