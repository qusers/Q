rl /zfsdata/data/david/Q/src/QligFEP/FF/AMBER14sb.lib 
rl ejm_44.lib
rl ejm_43_renumber.lib
rprm AMBER14sb_ejm_44_ejm_43_merged.prm 
! TO DO Change if protein system is used
rp ejm_44_ejm_43.pdb 
! solvation - density adapted to membrane proteins
set solvent_pack 2.3
set solute_density 0.05794
boundary 1 -4.65 26.586 -30.575 25
solvate -4.65 26.586 -30.575 25 1 HOH
!addbond at1 at2 y
maketop MKC_p 
writetop dualtop.top 
wp top_p.pdb y 
rt dualtop.top
mask none
mask not excluded 
wp complexnotexcluded.pdb y 
q 