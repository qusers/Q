rl /zfsdata/data/david/Q/src/QligFEP/FF/AMBER14sb.lib 
rl ejm_31.lib
rl ejm_48_renumber.lib
rprm AMBER14sb_ejm_31_ejm_48_merged.prm 
! TO DO Change if protein system is used
rp ejm_31_ejm_48.pdb 
! solvation - density adapted to membrane proteins
set solvent_pack 2.3
set solute_density 0.05794
boundary 1 -4.68 25.191 -30.597 25
solvate -4.68 25.191 -30.597 25 1 HOH
!addbond at1 at2 y
maketop MKC_p 
writetop dualtop.top 
wp top_p.pdb y 
rt dualtop.top
mask none
mask not excluded 
wp complexnotexcluded.pdb y 
q 